# The guest server (guest.mjs). Copy to .env; `npm start` loads it.

# The mnemonic whose accounts are the guests (0, 1, …) and the account that runs listed sales (CONSIGN):
# a file that holds it, or the phrase itself in GUESTS_MNEMONIC.
GUESTS_MNEMONIC_FILE=../.secrets/guests.mnemonic
# GUESTS_MNEMONIC=

# How many guest accounts to hand out, from index 0.
GUESTS=2

# The account index, in the same mnemonic, that issues each listed item's token and runs its sale.
CONSIGN=100
# The account (same mnemonic) that sends token-form fUSD to QoreX bidders who only have faucet fUSD.
TOPUP=50

# Where guest-bids.json, listings.json and uploaded files are kept.
DATA=./data

# One pair of Allot-managed lots. The second must remain open at least an hour past the first reveal deadline.
# BACKUP_LOTS=11,12

# The site's own origin: uploaded files are linked from each token's terms as PUBLIC/api/files/<sha256>.<ext>.
PUBLIC=https://allot.timidan.xyz

PORT=8787

# Uncomment to simulate guest bids instead of sending them.
# DRY=1

# setup-guests.mjs only, run on your own machine: the account that funds the guests and the consign account.
TREASURY_MNEMONIC_FILE=../.secrets/treasury.mnemonic
